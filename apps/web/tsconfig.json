{
  "extends": "@repo/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "paths": {
      // for shadcn CLI
      "@repo/ui/*": ["../../packages/ui/*"],
      "#/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
